# Server-side configuration for the Angular SSR app (read from process.env; not auto-loaded).
# Leave STRAPI_URL empty to run on the bundled static catalog without a CMS.

# Base URL the server uses to reach Strapi
STRAPI_URL=http://localhost:1337
# Base URL browsers use for uploaded media (defaults to STRAPI_URL)
STRAPI_PUBLIC_URL=
# Optional read-only API token (not needed while the Public role has find/findOne)
STRAPI_API_TOKEN=
# Optional token used when forwarding forms (not needed while the Public role has create)
STRAPI_FORMS_TOKEN=
# How long fetched content is cached on the server, in ms (default 30000)
STRAPI_CACHE_TTL_MS=30000
STRAPI_TIMEOUT_MS=5000
# Same value as FORMS_PROXY_SECRET in the CMS (.env): lets Strapi rate-limit by visitor IP
FORMS_PROXY_SECRET=
# Set to true when running behind a reverse proxy so req.ip is the visitor IP
TRUST_PROXY=false

# Public origin of the site (canonical, hreflang, sitemap, JSON-LD), no trailing slash
SITE_URL=http://localhost:4000
# Google Tag Manager container (GTM-XXXXXXX). Empty disables all tracking. Tags stay blocked until the visitor consents.
GTM_ID=
